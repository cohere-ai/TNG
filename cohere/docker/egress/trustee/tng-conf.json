{
    "control_interface": {
        "restful": {
            "host": "0.0.0.0",
            "port": 50000
        }
    },
    "add_egress": [
        {
            "attest": {
                "model": "background_check",
                "aa_provider": "coco_asr",
                "asr_addr": "http://127.0.0.1:8006/",
                "max_retries": 0
            },
            "direct_forward": [
                {
                    "http_path": "^/(ping|health|metrics)$"
                }
            ],
            "mapping": {
                "in": {
                    "host": "0.0.0.0",
                    "port": 18080
                },
                "out": {
                    "host": "127.0.0.1",
                    "port": 8080
                }
            },
            "ohttp": {
                "key": {
                    "attest": {
                        "model": "background_check",
                        "aa_provider": "coco_asr",
                        "asr_addr": "http://127.0.0.1:8006/",
                        "max_retries": 0
                    },
                    "peers": [],
                    "port": 8301,
                    "rotation_interval": 300,
                    "source": "peer_shared",
                    "push_pull_interval": 5,
                    "activation_delay": 15,
                    "join_max_attempts": 0,
                    "join_retry_interval": 5,
                    "verify": {
                        "model": "background_check",
                        "as_provider": "coco_builtin",
                        "policy_ids": ["trustee_policy"],
                        "required_tee_classes": ["cpu", "gpu"],
                        "policy_source": {
                            "url": "https://github.com/cohere-ai/integritee/releases/latest/download",
                            "provenance": {
                                "repo": "cohere-ai/integritee",
                                "signer_workflow": ".github/workflows/release-policy.yaml",
                                "source_ref": "refs/heads/main",
                                "predicate_type": "https://cohere.com/attestation-policy/v1",
                                "environment": "release"
                            }
                        },
                        "verifier_config": {
                            "nvidia_verifier": {
                                "type": "remote"
                            }
                        }
                    }
                }
            }
        }
    ]
}
