{
    "control_interface": {
        "restful": {
            "host": "0.0.0.0",
            "port": 50000
        }
    },
    "add_egress": [
        {
            "direct_forward": [
                {
                    "http_path": "^/(ping|health|metrics)$"
                }
            ],
            "mapping": {
                "in": {
                    "host": "0.0.0.0",
                    "port": 18080
                },
                "out": {
                    "host": "127.0.0.1",
                    "port": 8080
                }
            },
            "ohttp": {
                "key": {
                    "peers": [],
                    "port": 8301,
                    "rotation_interval": 300,
                    "source": "peer_shared",
                    "push_pull_interval": 5,
                    "activation_delay": 15,
                    "join_max_attempts": 0,
                    "join_retry_interval": 5
                }
            }
        }
    ]
}
