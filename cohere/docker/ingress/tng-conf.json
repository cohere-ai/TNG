{
    "add_ingress": [
        {
            "mapping": {
                "in": {
                    "host": "${IN_HOST}",
                    "port": ${IN_PORT}
                },
                "out": {
                    "host": "${OUT_HOST}",
                    "port": ${OUT_PORT},
                    "scheme": "${OUT_SCHEME}"
                }
            },
            "ohttp": {
                "direct_forward": [
                    {"http_path": "^/v1/models(?:/[^/]+)?$"}
                ],
                "forward_headers": [
                    "authorization"
                ],
                "body_field_headers": [
                    {
                        "field_name": "model",
                        "header_name": "x-gateway-model-name"
                    }
                ],
                "key_refresh_before_expiry_seconds": 5
            },
            "verify": [
                {
                    "model": "passport",
                    "as_provider": "ita",
                    "ita_jwks_addr": "https://portal.trustauthority.intel.com",
                    "policy_ids": [
                        "cbeedffa-e224-4664-b6b4-573fcd4133d3"
                    ]
                },
                {
                    "model": "background_check",
                    "as_provider": "coco_builtin",
                    "policy_ids": ["trustee_policy"],
                    "required_tee_classes": ["cpu", "gpu"],
                    "policy_source": {
                        "url": "https://github.com/cohere-ai/integritee/releases/latest/download",
                        "provenance": {
                            "repo": "cohere-ai/integritee",
                            "signer_workflow": ".github/workflows/release-policy.yaml",
                            "source_ref": "refs/heads/main",
                            "predicate_type": "https://cohere.com/attestation-policy/v1",
                            "environment": "release"
                        }
                    },
                    "verifier_config": {
                        "nvidia_verifier": {
                            "type": "remote"
                        }
                    }
                }
            ]
        }
    ]
}
