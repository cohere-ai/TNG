FROM ubuntu:24.04

# Tests use "set -euo pipefail" but ShellTask invokes "sh", which is dash on
# Ubuntu and does not support pipefail. Point sh to bash so those scripts work.
RUN ln -sf /bin/bash /bin/sh

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    protobuf-compiler libprotobuf-dev libssl-dev pkg-config clang \
    make perl git \
    iptables iproute2 iputils-ping dnsutils ipset jq socat \
    mold \
    && rm -rf /var/lib/apt/lists/*

# Intel DCAP quote verification library, required to build and run the TDX verifier that the
# in-process attestation service uses (rats-cert's coco-builtin-as-tdx feature). Only the quote verification library is needed, not the quote provider: this revision of the
# verifier fetches DCAP collateral itself over HTTPS from Intel's PCS and hands it to the library,
# so nothing here consults a quote provider config.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://download.01.org/intel-sgx/sgx_repo/ubuntu/intel-sgx-deb.key \
        -o /etc/apt/keyrings/intel-sgx.asc \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/intel-sgx.asc] https://download.01.org/intel-sgx/sgx_repo/ubuntu noble main" \
        > /etc/apt/sources.list.d/intel-sgx.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    libsgx-dcap-quote-verify-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.89.0
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="clang"
ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"

WORKDIR /workspace
