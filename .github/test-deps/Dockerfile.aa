# Attestation Agent with TDX attester for CI testing on GCP Confidential VMs.
# Uses TEE_PLATFORM=tdx build which uses real TDX hardware attestation via /dev/tdx_guest.
ARG AA_TAG=33055704017f7834b2708aeda664cee1373a922c-tdx_x86_64
ARG AA_IMAGE=ghcr.io/confidential-containers/guest-components/attestation-agent

FROM ubuntu:24.04 AS fetcher
ARG AA_TAG
ARG AA_IMAGE

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV ORAS_VERSION=1.3.0
RUN curl -sSL "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_amd64.tar.gz" \
    | tar -xz -C /usr/local/bin oras

WORKDIR /artifact
RUN oras pull "${AA_IMAGE}:${AA_TAG}" -o /artifact \
    && tar -xJf attestation-agent.tar.xz -C /artifact \
    && chmod +x /artifact/attestation-agent

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /run/confidential-containers/attestation-agent

COPY --from=fetcher /artifact/attestation-agent /usr/local/bin/attestation-agent

CMD ["attestation-agent"]
